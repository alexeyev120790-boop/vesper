# Resend API Configuration (Recommended - works via HTTPS without SMTP port blocks)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="VesperChat <onboarding@resend.dev>"

# SMTP Configuration (Fallback when RESEND_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="VesperChat Messenger <your_email@gmail.com>"


